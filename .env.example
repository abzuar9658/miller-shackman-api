APP_NAME="Miller Schackman API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG="true"
LOG_LEVEL="INFO"
METRICS_ENABLED="true"
FRONTEND_APP_BASE_URL="http://localhost:5173"
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173", "http://127.0.0.1:4173"]'

# Host-local defaults. The Docker Compose api service overrides these to use
# service hostnames such as postgres, rabbitmq, temporal, and redis.
# High host ports reduce collisions with developer machines already running
# PostgreSQL, Redis, RabbitMQ, or Temporal locally.
POSTGRES_DB="miller_schackman"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:55432/miller_schackman"
DATABASE_MIGRATION_URL="postgresql+psycopg://postgres:postgres@localhost:55432/miller_schackman"
# Optional compose-only overrides for the api container when it runs inside Docker.
DATABASE_URL_DOCKER=""
DATABASE_MIGRATION_URL_DOCKER=""
# Connection pool sizing per process; keep (pool_size + max_overflow) x process
# count under the Postgres max_connections budget.
DATABASE_POOL_SIZE="5"
DATABASE_MAX_OVERFLOW="5"
DATABASE_POOL_TIMEOUT_SECONDS="30"
DATABASE_POOL_RECYCLE_SECONDS="1800"
# Server-side query guards in milliseconds; 0 disables.
DATABASE_STATEMENT_TIMEOUT_MS="60000"
DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS="120000"
DATABASE_LOCK_TIMEOUT_MS="15000"
RABBITMQ_URL="amqp://guest:guest@localhost:55672/"
CRM_SYNC_EXCHANGE_NAME="miller_schackman.events"
CRM_SYNC_QUEUE_NAME="miller_schackman.crm_sync"
CRM_SYNC_WORKER_PREFETCH_COUNT="1"
CRM_SYNC_INCREMENTAL_INTERVAL_SECONDS="300"
CRM_SYNC_SCHEDULER_POLL_SECONDS="60"
CRM_SYNC_SCHEDULER_WORKSPACE_LIMIT="100"
OUTBOUND_SEND_DISPATCH_POLL_SECONDS="1"
OUTBOUND_SEND_DISPATCH_BATCH_SIZE="100"
OUTBOUND_SEND_DISPATCH_STALE_SECONDS="300"
OUTBOUND_SEND_DISPATCH_METRICS_HOST="127.0.0.1"
OUTBOUND_SEND_DISPATCH_METRICS_PORT="9101"
TEMPORAL_ADDRESS="localhost:57233"
TEMPORAL_TASK_QUEUE="miller-schackman-task-queue"
# JSON UUID list. Only listed workspaces may run recurring paused-search
# maintenance when their persisted operational flag is enabled.
RECURRING_PAUSED_SEARCH_PILOT_WORKSPACE_IDS='[]'

# CloudBeaver DB explorer
CLOUDBEAVER_SERVER_NAME="Miller Schackman DB Explorer"
CLOUDBEAVER_SERVER_URL="http://localhost:58978/"
CLOUDBEAVER_ADMIN_NAME="cbadmin"
CLOUDBEAVER_ADMIN_PASSWORD="change-me-local-cloudbeaver-admin"
CLOUDBEAVER_DB_CONNECTION_NAME="Miller Schackman Postgres"
CLOUDBEAVER_DB_HOST="postgres"
CLOUDBEAVER_DB_PORT="5432"

CRM_PROVIDER="follow_up_boss"
# Optional for routine local development. Required only when exercising live CRM paths.
FUB_API_KEY=""
FUB_BASE_URL="https://api.followupboss.com/v1"
FUB_INBOX_SYNC_ENABLED="false"
FUB_HISTORY_IMPORT_ENABLED="false"
FUB_INBOX_APP_ID=""
FUB_INBOX_SENDER_NAME="AI Assistant"

LLM_PROVIDER="openrouter"
# Optional for routine local development. Required only when exercising live LLM paths.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Optional task-split defaults; empty values fall back to OPENROUTER_MODEL.
OPENROUTER_DRAFTING_MODEL=""
OPENROUTER_CLASSIFICATION_MODEL=""
# Curated options admins can select from on the dashboard.
OPENROUTER_ALLOWED_MODELS='["openai/gpt-4o-mini", "openai/gpt-4o", "openai/gpt-4.1-mini", "anthropic/claude-sonnet-4.5", "anthropic/claude-haiku-4.5", "google/gemini-2.5-flash"]'

# Amazon Bedrock (optional; enable only when workspaces should be able to select it).
# Each model family must also be granted model access in the AWS Bedrock console
# for the account/region before it can be invoked.
BEDROCK_ENABLED="false"
BEDROCK_REGION="us-east-1"
# Leave credentials empty to use the default AWS credential chain (IAM role in
# production). Kept separate from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (S3)
# because the two capabilities need different IAM policies.
BEDROCK_ACCESS_KEY_ID=""
BEDROCK_SECRET_ACCESS_KEY=""
BEDROCK_SESSION_TOKEN=""
BEDROCK_DRAFTING_MODEL="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
BEDROCK_CLASSIFICATION_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Curated options admins can select from on the dashboard.
BEDROCK_ALLOWED_MODELS='["us.anthropic.claude-sonnet-4-5-20250929-v1:0", "us.anthropic.claude-haiku-4-5-20251001-v1:0", "us.amazon.nova-pro-v1:0", "us.amazon.nova-lite-v1:0", "us.meta.llama3-3-70b-instruct-v1:0"]'

SMS_PROVIDER="twilio"
# Optional for routine local development. Required only when exercising live SMS paths.
# Use "sink" for dev-only delivery that captures messages in memory instead of
# calling a real provider.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

EMAIL_PROVIDER="mailpit"
# Default sender address for all email providers. SendGrid can override this
# with SENDGRID_FROM_EMAIL if needed.
EMAIL_FROM_EMAIL="noreply@local.millerschackman.test"
# Optional for routine local development. Required only when exercising live email paths.
# Use "mailpit" for a local SMTP inbox with a browser UI, "mailgun" for a real
# sandbox provider, or "sink" for dev-only delivery that captures messages in
# memory instead of calling a real provider.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_WEBHOOK_SIGNING_KEY=""
MAILPIT_SMTP_HOST="localhost"
MAILPIT_SMTP_PORT="51025"

STORAGE_PROVIDER="s3"
# Optional for routine local development. Required only when exercising storage paths.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"

CACHE_PROVIDER="redis"
REDIS_URL="redis://localhost:56379/0"

# Auth
# Required for access token signing. Must be a strong random secret.
AUTH_JWT_SECRET="change-me-in-production"
AUTH_JWT_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_TTL_MINUTES="15"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
AUTH_INVITATION_TOKEN_TTL_DAYS="7"
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES="30"
AUTH_SIGNIN_LOCKOUT_MAX_ATTEMPTS="5"
AUTH_SIGNIN_LOCKOUT_WINDOW_MINUTES="15"


LISTING_CONTEXT_ENRICHMENT_ENABLED=true
LISTING_CONTEXT_ENRICHMENT_MAX_RESULTS=3
LISTING_CONTEXT_ENRICHMENT_CACHE_TTL_MINUTES=60