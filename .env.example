APP_NAME="Miller Schackman API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG="true"
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS='["http://localhost:5173"]'
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/miller_schackman"
DATABASE_MIGRATION_URL="postgresql+psycopg://postgres:postgres@localhost:5432/miller_schackman"
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
TEMPORAL_ADDRESS="localhost:7233"

CRM_PROVIDER="follow_up_boss"
FUB_API_KEY=""
FUB_BASE_URL="https://api.followupboss.com/v1"

LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"

SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

STORAGE_PROVIDER="s3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"

CACHE_PROVIDER="redis"
REDIS_URL="redis://localhost:6379/0"
